{
  "marka": "Dahua",
  "oncelik": 100,
  "parmakizi": {
    "onvif_uretici_icerir": ["dahua", "amcrest", "lorex"],
    "http_server_basligi_icerir": ["Webs", "DahuaHttpd", "Dahua"],
    "http_yol_kontrolu": [
      { "yol": "/RPC2_Login", "beklenen_durum": 200 }
    ]
  },
  "kimlik_dogrulama": "digest",
  "rtsp": {
    "ana_akis": "/cam/realmonitor?channel={kanal}&subtype=0",
    "alt_akis": "/cam/realmonitor?channel={kanal}&subtype=1"
  },
  "durum_kontrolu": {
    "yol": "/cgi-bin/magicBox.cgi?action=getSystemInfo",
    "format": "duzmetin",
    "basari_kosulu": "deviceType"
  },
  "kanal_listesi": {
    "yol": "/cgi-bin/configManager.cgi?action=getConfig&name=RemoteDevice",
    "format": "duzmetin",
    "liste_yolu": "table.RemoteDevice",
    "alan_eslemesi": {
      "kanal_no": "id",
      "ad": "DeviceName",
      "ip": "Address",
      "cevrimici": "Enable"
    }
  },
  "olay_akisi": {
    "yol": "/cgi-bin/eventManager.cgi?action=attach&codes=[All]",
    "tip": "multipart",
    "format": "duzmetin",
    "olay_yolu": "",
    "alan_eslemesi": {
      "olay_tipi": "Code",
      "kanal_no": "index"
    },
    "olay_eslemesi": {
      "videoloss": "sinyal_kaybi",
      "videoblind": "sinyal_kaybi",
      "hdderror": "disk_hatasi",
      "loginfailure": "yetkisiz_erisim"
    }
  }
}
